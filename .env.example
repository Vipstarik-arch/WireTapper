# WireTapper API credentials.
#
# Copy this file to `.env` (which is git-ignored) and fill in the keys you have,
# or set them at runtime — both paths write to the same place:
#
#   wiretaper config SHODAN_API_KEY=xxxx          # saved to credentials.db
#   wt> set SHODAN_API_KEY xxxx                   # same, from chat mode
#   the web UI -> Settings (/api/settings)        # same
#
# Lookup order: credentials.db -> .env -> environment variables.
# A key left at its `your_...` placeholder counts as "not configured" and the
# matching source is reported as skipped instead of being called.

# WiGLE.net — Wi-Fi / Bluetooth / cell-tower search (https://wigle.net/account)
WIGLE_API_NAME=your_wigle_api_name
WIGLE_API_TOKEN=your_wigle_api_token

# OpenCellID / Unwired Labs — cell tower database (https://opencellid.org/#apis)
OPENCELLID_API_KEY=your_opencellid_api_key

# Shodan — internet-facing IoT / SCADA / camera search (https://account.shodan.io/)
SHODAN_API_KEY=your_shodan_api_key

# Censys Search API v2 — host/service search (https://search.censys.io/account/api)
CENSYS_API_ID=your_censys_api_id
CENSYS_API_SECRET=your_censys_api_secret
